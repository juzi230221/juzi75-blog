---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getNovels } from "@/utils/novel-utils";

const novels = await getNovels();
---

<MainGridLayout title="小说" description="阅读小说章节">
  <div class="flex flex-col gap-6">
    <div class="card-base p-6">
      <h1 class="text-3xl font-bold mb-2 text-black/90 dark:text-white/90">小说</h1>
      <p class="text-sm text-black/70 dark:text-white/70">
        这里是一些原创小说。
      </p>
    </div>

    {novels.map((novel) => (
      <div class="card-base p-6 flex flex-col gap-4">
        <div>
          <a href={`/novels/${novel.slug}/`} class="text-2xl font-semibold text-(--primary) transition hover:opacity-80 dark:text-white">
            {novel.title}
          </a>
          <p class="mt-2 whitespace-pre-wrap text-sm leading-6 text-black/70 dark:text-white/70">{novel.description}</p>
        </div>

        <div class="flex flex-col gap-3 md:flex-row md:items-end md:gap-4">
          <div class="flex-1">
            <label class="block text-sm font-medium mb-2 text-black/80 dark:text-white/80" for={`jump-${novel.slug}`}>输入章节号</label>
            <input
              id={`jump-${novel.slug}`}
              class="w-full rounded-lg border border-black/10 bg-white/70 px-3 py-2 text-sm text-black/80 outline-none placeholder:text-black/40 dark:border-white/10 dark:bg-black/20 dark:text-white/80 dark:placeholder:text-white/40"
              placeholder="例如 2"
            />
          </div>
          <button
            class="rounded-lg bg-(--primary) px-4 py-2 text-sm font-medium text-white"
            type="button"
            onclick={`const input = document.getElementById('jump-${novel.slug}'); const value = input?.value.trim(); const path = value ? '/novels/${novel.slug}/' + encodeURIComponent(value) + '/' : '/novels/${novel.slug}/'; window.location.assign(path);`}
          >
            跳转
          </button>
        </div>
      </div>
    ))}
  </div>
</MainGridLayout>
